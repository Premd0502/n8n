    {
      "parameters": {
        "jsCode": "const { exec } = require('child_process');\nconst util = require('util');\nconst execPromise = util.promisify(exec);\n\nconst servers = [];\n\nconst ansibleInventory = '/etc/ansible/hosts';\n\nconst commands = {\n  serverInfo: 'ansible all -m setup -a \"filter=ansible_hostname,ansible_distribution,ansible_distribution_version,ansible_processor_cores,ansible_memtotal_mb\" --one-line',\n  diskInfo: 'ansible all -m shell -a \"df -h | grep -v tmpfs\" --one-line',\n  memoryInfo: 'ansible all -m shell -a \"free -h\" --one-line',\n  diskIO: 'ansible all -m shell -a \"iostat -x 1 2 | tail -n +4\" --one-line',\n  logHealth: 'ansible all -m shell -a \"journalctl -p err -n 50 --no-pager\" --one-line'\n};\n\nasync function runAnsibleCommand(cmd) {\n  try {\n    const { stdout, stderr } = await execPromise(cmd);\n    return stdout;\n  } catch (error) {\n    return `Error: ${error.message}`;\n  }\n}\n\nconst results = await Promise.all([\n  runAnsibleCommand(commands.serverInfo),\n  runAnsibleCommand(commands.diskInfo),\n  runAnsibleCommand(commands.memoryInfo),\n  runAnsibleCommand(commands.diskIO),\n  runAnsibleCommand(commands.logHealth)\n]);\n\nconst [serverInfoRaw, diskInfoRaw, memoryInfoRaw, diskIORaw, logHealthRaw] = results;\n\nconst serverLines = serverInfoRaw.split('\\n').filter(line => line.trim() && line.includes('SUCCESS'));\n\nfor (const line of serverLines) {\n  const match = line.match(/^([^\\s]+)\\s+\\|\\s+SUCCESS/);\n  if (match) {\n    const hostname = match[1];\n    \n    const diskLine = diskInfoRaw.split('\\n').find(l => l.startsWith(hostname));\n    const memLine = memoryInfoRaw.split('\\n').find(l => l.startsWith(hostname));\n    const ioLine = diskIORaw.split('\\n').find(l => l.startsWith(hostname));\n    const logLine = logHealthRaw.split('\\n').find(l => l.startsWith(hostname));\n    \n    servers.push({\n      hostname: hostname,\n      serverInfo: line,\n      diskInfo: diskLine || 'N/A',\n      memoryInfo: memLine || 'N/A',\n      diskIO: ioLine || 'N/A',\n      logHealth: logLine || 'N/A',\n      timestamp: new Date().toISOString()\n    });\n  }\n}\n\nreturn servers.map(server => ({ json: server }));"
      },
