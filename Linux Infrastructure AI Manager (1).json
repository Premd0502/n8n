      "id": "92eb68b0-c32c-4be5-861c-6ccb9866a9ea",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        400
      ]
