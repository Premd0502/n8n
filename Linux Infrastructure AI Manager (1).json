      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following data from 50 Linux servers managed via Ansible:\n\n{{ $json.servers }}\n\nProvide a comprehensive analysis including:\n1. Overall infrastructure health status\n2. Critical issues requiring immediate attention (disk space >90%, memory issues, high I/O wait, critical errors in logs)\n3. Warnings and potential issues (disk space >75%, moderate resource usage)\n4. Performance optimization recommendations\n5. Security concerns from log analysis\n6. Capacity planning insights\n\nBe specific about which servers have issues and provide actionable recommendations.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert Linux System Administrator and Infrastructure Analyst with 20+ years of experience managing large-scale server infrastructures. You excel at identifying critical issues, performance bottlenecks, security vulnerabilities, and providing actionable recommendations. Your analysis is thorough, prioritized by severity, and includes specific remediation steps."
        }
