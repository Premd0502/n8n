        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"technologies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"category\": { \"type\": \"string\" },\n          \"description\": { \"type\": \"string\" },\n          \"releaseDate\": { \"type\": \"string\" },\n          \"keyFeatures\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          },\n          \"source\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"summary\": { \"type\": \"string\" }\n  }\n}"
