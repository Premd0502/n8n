    {
      "parameters": {
        "promptType": "define",
        "text": "You are an incident response specialist. Create comprehensive incident response plans for security threats. For each incident type:\n1. Define detection phase: indicators, tools, and initial actions\n2. Outline containment phase: immediate and short-term actions\n3. Detail eradication phase: removal and verification steps\n4. Plan recovery phase: restoration steps and timeline\n5. Specify post-incident activities: documentation and improvements\n6. Identify key stakeholders and communication plan\n\nFollow NIST incident response framework. Focus on ransomware, data breaches, DDoS, and insider threats.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an incident response expert following NIST guidelines. Use the Incident Response Search tool to find best practices. Create actionable, detailed plans.",
          "maxIterations": 5
        }
      },
