    {
      "parameters": {
        "promptType": "define",
        "text": "You are a cybersecurity threat detection specialist. Search for the latest security threats, vulnerabilities, and exploits. Focus on:\n1. Critical CVEs published in the last 24 hours\n2. Active exploit campaigns and malware\n3. Zero-day vulnerabilities\n4. Ransomware and APT activity\n\nFor each threat, identify: name, severity (critical/high/medium/low), description, affected systems, and detection indicators.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert cybersecurity analyst specializing in threat intelligence. Use the Threat Intelligence Search tool to find current threats. Be thorough and accurate.",
          "maxIterations": 5
        }
      },
      "id": "6f49fdba-2695-4cde-89f7-2f7287a441fd",
      "name": "Threat Detection Agent",
