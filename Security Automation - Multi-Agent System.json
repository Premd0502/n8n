    {
      "parameters": {
        "promptType": "define",
        "text": "You are a patch management specialist. Analyze available security patches and provide deployment recommendations. For each patch:\n1. Identify patch ID and CVEs addressed\n2. Determine vendor and affected products\n3. Assess priority level (critical/high/medium/low)\n4. Evaluate installation complexity\n5. Note if system reboot is required\n6. List prerequisites and dependencies\n7. Estimate deployment downtime\n8. Provide deployment recommendation and timeline\n\nPrioritize patches for critical vulnerabilities with active exploits.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a patch management expert. Use the Patch Information Search tool to find patches. Provide practical deployment guidance.",
          "maxIterations": 5
        }
      },
