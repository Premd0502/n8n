      "position": [
        240,
        400
      ],
      "webhookId": "d5d5098b-aa9d-4708-a920-226674e16d8a"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following security log event and identify potential threats:\n\nTimestamp: {{ $json.body.timestamp }}\nSource: {{ $json.body.source }}\nEvent Type: {{ $json.body.event_type }}\nSource IP: {{ $json.body.src_ip }}\nDestination IP: {{ $json.body.dst_ip }}\nPort: {{ $json.body.port }}\nProtocol: {{ $json.body.protocol }}\nAction: {{ $json.body.action }}\nMessage: {{ $json.body.message }}\n\nIdentify threat type, category, indicators, affected systems, attack vector, and provide confidence score.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a cybersecurity threat analysis expert. Analyze security log events to identify threats, categorize them, and assess confidence levels. Return structured JSON output with threat details."
        }
      },
      "id": "2e80fafb-5417-4c51-8de5-64d7cbb3e2ef",
      "name": "Threat Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        464,
        400
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
