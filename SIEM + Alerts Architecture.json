        "builtInTools": {},
        "options": {
          "temperature": 0.3
        }
      },
      "id": "7828b4ba-04a9-4e24-b89f-1a86eaa1802e",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        480,
        624
      ],
      "credentials": {
        "openAiApi": {
          "id": "R0UZFlOQ5a6MsKNH",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": {
          "threat_detected": true,
          "threat_type": "brute_force_attack",
          "threat_category": "authentication",
          "indicators": [
            "multiple_failed_logins",
            "suspicious_ip"
          ],
          "affected_systems": [
            "firewall",
            "ssh_server"
          ],
          "attack_vector": "SSH brute force",
          "confidence": 0.95,
          "analysis": "Multiple failed SSH login attempts from external IP indicate potential brute force attack"
        }
      },
      "id": "c1b46da9-1785-4e0f-9e2d-9f77f39cf0d7",
      "name": "Threat Analysis Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        608,
        624
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Based on the threat analysis below, calculate a comprehensive risk score:\n\nThreat Type: {{ $json.output.threat_type }}\nThreat Category: {{ $json.output.threat_category }}\nIndicators: {{ $json.output.indicators }}\nAffected Systems: {{ $json.output.affected_systems }}\nAttack Vector: {{ $json.output.attack_vector }}\nConfidence: {{ $json.output.confidence }}\nAnalysis: {{ $json.output.analysis }}\n\nProvide risk score (0-100), risk level, severity, impact score, likelihood score, business impact, recommended actions, urgency, and SLA deadline.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a cybersecurity risk assessment expert. Calculate comprehensive risk scores based on threat analysis, considering impact, likelihood, business context, and urgency. Return structured JSON output with risk metrics and recommended actions."
        }
      },
      "id": "62f4ba4d-887a-47cc-98a3-da8a332f5106",
      "name": "Risk Scoring Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        816,
        400
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": {
          "risk_score": 85,
          "risk_level": "HIGH",
          "severity": "critical",
          "impact_score": 8,
          "likelihood_score": 9,
          "business_impact": "potential_data_breach",
          "recommended_actions": [
            "block_ip",
            "enable_mfa",
            "alert_security_team"
          ],
          "urgency": "immediate",
          "sla_deadline": "15 minutes"
        }
      },
      "id": "6cd51ce6-c845-435a-842b-8685c964955b",
      "name": "Risk Scoring Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        896,
        624
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Format a comprehensive security alert based on the following information:\n\nTHREAT ANALYSIS:\nThreat Type: {{ $(\"Threat Analysis Agent\").item.json.output.threat_type }}\nCategory: {{ $(\"Threat Analysis Agent\").item.json.output.threat_category }}\nAttack Vector: {{ $(\"Threat Analysis Agent\").item.json.output.attack_vector }}\nAnalysis: {{ $(\"Threat Analysis Agent\").item.json.output.analysis }}\n\nRISK ASSESSMENT:\nRisk Score: {{ $json.output.risk_score }}/100\nRisk Level: {{ $json.output.risk_level }}\nSeverity: {{ $json.output.severity }}\nBusiness Impact: {{ $json.output.business_impact }}\nRecommended Actions: {{ $json.output.recommended_actions }}\nUrgency: {{ $json.output.urgency }}\nSLA Deadline: {{ $json.output.sla_deadline }}\n\nORIGINAL LOG:\nSource IP: {{ $(\"Receive Logs\").item.json.body.src_ip }}\nDestination IP: {{ $(\"Receive Logs\").item.json.body.dst_ip }}\nPort: {{ $(\"Receive Logs\").item.json.body.port }}\nProtocol: {{ $(\"Receive Logs\").item.json.body.protocol }}\n\nCreate alert_title, alert_summary, telegram_message (concise with emojis), email_subject, email_body (detailed HTML), priority, and incident_id.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a security alert formatting expert. Create clear, actionable security alerts for multiple channels (Telegram, Email). Format messages appropriately for each channel with proper urgency indicators and incident tracking. Return structured JSON output."
        }
      },
      "id": "f315a1d7-f74f-4753-bc52-022d19557e29",
      "name": "Alert Formatter Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1168,
        400
      ]
    },
    {
      "parameters": {
