          "alert_summary": "High-risk brute force attack targeting SSH service",
          "telegram_message": "Detailed alert for Telegram",
          "email_subject": "CRITICAL SECURITY ALERT: SSH Brute Force Attack",
          "email_body": "Detailed email body with HTML formatting",
